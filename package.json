{
  "name": "activity-sheet-checker",
  "version": "1.0.0",
  "private": true,
  "description": "ระบบตรวจใบกิจกรรมสำหรับครูและนักเรียน",
  "type": "commonjs",
  "main": "server/index.js",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch server/index.js",
    "seed": "node --disable-warning=ExperimentalWarning scripts/seed.js",
    "reset": "node scripts/reset.js",
    "build:demo": "node scripts/build-demo.js",
    "test:apps-script": "node scripts/test-apps-script.js",
    "mock:apps-script": "node scripts/mock-apps-script-server.js",
    "export:sheet": "node --disable-warning=ExperimentalWarning scripts/export-sheet.js"
  },
  "engines": {
    "node": ">=22.14"
  },
  "dependencies": {
    "express": "^5.1.0",
    "multer": "^2.0.2"
  }
}
